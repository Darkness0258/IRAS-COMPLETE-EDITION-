# ============================================================
# IRAS v4.2 RC1 — local brain / provider
# Keep real secrets only in your private .env or deployment secret store.
# ============================================================
IRAS_PROVIDER=multi
# Keep UI/terminal available before a full reasoning provider is configured.
IRAS_MULTI_DEMO_FALLBACK=true
IRAS_MODEL=openrouter/free
IRAS_BASE_URL=https://openrouter.ai/api/v1
IRAS_REQUEST_TIMEOUT=90
IRAS_MAX_OUTPUT_TOKENS=360

# Cloud providers (configure any subset; multi mode fails over in order).
OPENROUTER_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
GEMINI_API_KEY=
IRAS_PROVIDER_ORDER=groq,cerebras,cloudflare,gemini,openrouter,ollama

# Optional offline/local last-resort model.
IRAS_OLLAMA_FALLBACK=false
IRAS_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
IRAS_OLLAMA_MODEL=qwen2.5-coder:7b
IRAS_OLLAMA_TIMEOUT=45

# ============================================================
# Controller security
# ============================================================
IRAS_AUTO_PERMISSION_LEVEL=1
IRAS_ALWAYS_CONFIRM_CRITICAL=true
IRAS_NODE_TOKEN=generate_a_long_random_node_token
IRAS_NODE_MAX_PERMISSION_LEVEL=1

# Remote/cloud master token: use 32+ random bytes. Never expose it in a client
# bundle or commit it to Git. The web client keeps it in sessionStorage only.
IRAS_API_TOKEN=generate_a_long_random_api_token

# ============================================================
# ============================================================
# RC10 Authorized Web Operator
# ============================================================
IRAS_WEB_HEADLESS=true
IRAS_WEB_PROFILE=owner
IRAS_WEB_DEFAULT_SEARCH=bing
IRAS_WEB_ALLOW_HTTP=true
IRAS_WEB_ALLOW_PRIVATE=false
IRAS_WEB_ALLOW_LOCALHOST=true
IRAS_WEB_ALLOW_SENSITIVE_UPLOADS=false
IRAS_WEB_MAX_DOWNLOAD_MB=1024
IRAS_WEB_NAV_TIMEOUT_MS=45000
IRAS_WEB_ACTION_TIMEOUT_MS=20000

# Voice
# ============================================================
IRAS_TTS_PROVIDER=edge
IRAS_VOICE_PROFILE=iras_human
IRAS_HUMAN_VOICE=en-US-AvaMultilingualNeural
IRAS_HUMAN_VOICE_FALLBACKS=en-US-EmmaMultilingualNeural,en-US-PhoebeMultilingualNeural,en-US-JennyNeural
IRAS_VOICE=en-US-AriaNeural
IRAS_VOICE_REPLIES=true
IRAS_STT_PROVIDER=whisper_local
IRAS_WHISPER_MODEL=base
# auto keeps Faster-Whisper multilingual detection active for English/Urdu/Roman Urdu.
# Set en, ur, etc. only when you intentionally want to force one STT language.
IRAS_STT_LANGUAGE=auto
IRAS_LANGUAGE=roman-urdu
# Latin-script Roman Urdu TTS; native Urdu script still uses ur-PK-UzmaNeural.
IRAS_ROMAN_URDU_VOICE=en-IN-NeerjaNeural
IRAS_VOICE_MOOD=warm
IRAS_VOICE_GENDER=female
IRAS_LISTEN_SECONDS=6
# Optional sounddevice index or device name. Empty/auto selects the best physical
# input automatically (Realtek + WASAPI is preferred; WO Mic/virtual inputs rank lower).
IRAS_MIC_DEVICE=auto
# true = never fall back if the explicitly selected device cannot be opened.
IRAS_MIC_STRICT=false
# Adaptive speech detector. Lower threshold helps quiet laptop microphones.
IRAS_MIC_ENERGY_THRESHOLD=0.004
IRAS_MIC_NOISE_MULTIPLIER=2.6
# Optional Whisper context/hotword overrides. Leave blank to use IRAS defaults.
IRAS_STT_PROMPT=
IRAS_STT_HOTWORDS=IRAS Iris Eris Windows Chrome Spotify VS Code GitHub PowerShell Python
# Local wake-session controls.
IRAS_WAKE_SESSION=true
IRAS_WAKE_WORDS=iras
IRAS_WAKE_END_PHRASES=done that's all|that's all|done iras|end session
IRAS_WAKE_IDLE_SECONDS=3
IRAS_WAKE_ACTIVE_SECONDS=30
# Local spoken permission confirmations. Voice is convenience, not biometric identity.
# SYSTEM actions require 'IRAS approve'. CRITICAL actions require a fresh 4-digit challenge.
IRAS_VOICE_APPROVALS=true
IRAS_VOICE_APPROVAL_CRITICAL=true
IRAS_VOICE_APPROVAL_TIMEOUT=9
# Universal terminal output cap per call (characters). CLI names are discovered at runtime.
IRAS_TERMINAL_MAX_OUTPUT=50000

# ============================================================
# Runtime / memory
# ============================================================
IRAS_DATA_DIR=data
IRAS_LOG_DIR=logs
IRAS_MAX_AGENT_STEPS=8
IRAS_SYSTEM_NAME=IRAS
IRAS_ADAPTIVE_PERSONALITY=true

# ============================================================
# Multimodal Windows control — UIA -> OCR ROI -> full vision only if needed
# ============================================================
IRAS_OMNIPARSER_AUTOSTART=true
IRAS_OMNIPARSER_ALLOW_EXTERNAL=false
IRAS_OMNIPARSER_EAGER_START=true
IRAS_OMNIPARSER_WATCHDOG=true
IRAS_OMNIPARSER_WATCHDOG_SECONDS=20
IRAS_OMNIPARSER_URL=http://127.0.0.1:8010
# install.ps1 provisions this automatically under %USERPROFILE%\.iras\OmniParser.
# IRAS_OMNIPARSER_ROOT=C:\Users\you\.iras\OmniParser
IRAS_OMNIPARSER_START_TIMEOUT=45
IRAS_OMNIPARSER_TIMEOUT=120
IRAS_OMNIPARSER_CACHE_TTL=180
IRAS_OMNIPARSER_PROBE_TIMEOUT=4
IRAS_OMNIPARSER_DEVICE=cpu
IRAS_OMNIPARSER_BRIDGE=true
IRAS_OMNIPARSER_DISABLE_PADDLE=true
IRAS_OMNIPARSER_TEXT_PREWARM=true
IRAS_OMNIPARSER_ROI_MAX_WIDTH=960
IRAS_OMNIPARSER_ROI_MAX_HEIGHT=720
IRAS_VISUAL_ACTION_MIN_CONFIDENCE=0.72
# RC11 screen intelligence: high-resolution capture remains bounded; actions still require fresh element IDs.
IRAS_COMPUTER_VISION_MAX_WIDTH=1600
IRAS_COMPUTER_VISION_MAX_HEIGHT=1200
IRAS_COMPUTER_OBSERVATION_TTL=30
# RC11 deliberate-calm repair planning (2..8 candidate routes, default 4).
IRAS_DELIBERATION_CANDIDATES=4
IRAS_WHATSAPP_ROI_FASTPATH=true
IRAS_WHATSAPP_COLD_ROI_RETRIES=2
IRAS_WHATSAPP_COLD_SETTLE_MS=220
# Text-centric WhatsApp control stays OCR/UIA-only by default. Enable this only
# if an unusual icon-only layout truly requires Florence/YOLO as the last resort.
IRAS_WHATSAPP_FULL_VISION_FALLBACK=false

# ============================================================
# Global remote Windows access — cloud server settings
# ============================================================
IRAS_PUBLIC_BASE_URL=
# PC cloud client. IRAS_CLOUD_TOKEN defaults to IRAS_API_TOKEN when omitted.
IRAS_CLOUD_URL=https://iras-cloud.onrender.com
IRAS_CLOUD_TOKEN=
DATABASE_URL=
IRAS_CORS_ORIGINS=*
PORT=8000

# Server-side ceiling for short-lived remote sessions:
# 0=READ, 1=SAFE_ACTION, 2=SYSTEM_ACTION, 3=CRITICAL.
# Full remote administration requires 3, while the laptop's local policy remains
# the final gate and separately controls restart/shutdown and command execution.
IRAS_REMOTE_SESSION_MAX_PERMISSION_LEVEL=3

# Laptop-side remote access is normally managed by `iras --remote-arm ...` and
# persisted under ~/.iras. Environment overrides are available for managed hosts.
IRAS_REMOTE_ACCESS_ENABLED=false
IRAS_REMOTE_ACCESS_MODE=off
IRAS_REMOTE_ACCESS_PERSISTENT=false
IRAS_REMOTE_ALLOW_POWER=false
IRAS_REMOTE_ALLOW_SHELL=false

# File tools remain contained to configured roots. To intentionally expose whole
# Windows drives, configure the bridge with --allowed-root C:\ --allowed-root D:\.
IRAS_BRIDGE_ROOTS=

# v4.1 bounded parallel task execution
IRAS_MULTITASK_WORKERS=4
IRAS_MULTITASK_MAX_TASKS=8
IRAS_MULTITASK_WAIT_TIMEOUT=300
IRAS_MULTITASK_MAX_ACTIVE_RUNS=4


# v4.2 automatic chat execution routing
IRAS_AUTONOMOUS_EXECUTION=true
IRAS_AUTONOMOUS_WAIT_TIMEOUT=600

# v4.2 multi-agent task-graph execution
IRAS_ORCHESTRATION_WORKERS=4
IRAS_ORCHESTRATION_MAX_TASKS=12
IRAS_ORCHESTRATION_PROVIDER_WAIT_SECONDS=21600
IRAS_ORCHESTRATION_DEVICE_WAIT_SECONDS=180
IRAS_ORCHESTRATION_AGENT_MAX_STEPS=14
IRAS_ORCHESTRATION_MAX_ACTIVE_RUNS=4
# Planner produces a compact DAG; the final Coordinator node is added automatically.

# Paired-Windows local AI last-resort fallback for multi-agent workers.
IRAS_DEVICE_OLLAMA_FALLBACK=true
IRAS_DEVICE_OLLAMA_MODEL=
IRAS_DEVICE_OLLAMA_TIMEOUT=120
IRAS_DEVICE_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
IRAS_DEVICE_OLLAMA_MODELS=qwen2.5-coder:7b,qwen2.5-coder:1.5b,llama3.1:8b,llama3

IRAS_PROVIDER_HEALTH_STALE_SECONDS=300

# ============================================================
# IRAS v5 autonomy / encrypted vault
# ============================================================
IRAS_V5_SCHEDULER_ENABLED=true
# Non-Windows cloud vault encryption: URL-safe base64 of 32 random bytes.
# Example generator: python -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
IRAS_VAULT_MASTER_KEY=

# v5 RC3 background service tuning (local/offline-safe)
IRAS_V5_SCHEDULER_WORKERS=4
IRAS_V5_MONITOR_POLL_SECONDS=15

# Emergency Master Control execution profile. Master Control still preserves
# emergency stop, authentication, OS/UAC boundaries, audit, and safety rules.
# These replace ordinary small workflow budgets while Master is locally armed
# or a verified CRITICAL remote session carries the `master` scope.
IRAS_MASTER_AGENT_STEPS=256
IRAS_MASTER_RUNTIME_SECONDS=21600
IRAS_MASTER_PARALLEL_TASKS=128
IRAS_MASTER_ORCHESTRATION_TASKS=128
IRAS_MASTER_ACTIVE_RUNS=32
IRAS_MASTER_PROVIDER_WAIT_SECONDS=86400
IRAS_MASTER_RECOVERY_ATTEMPTS=24
