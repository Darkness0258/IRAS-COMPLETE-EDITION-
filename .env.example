# ============================================================
# IRAS v4.2 RC1 — local brain / provider
# Keep real secrets only in your private .env or deployment secret store.
# ============================================================
IRAS_PROVIDER=multi
IRAS_MODEL=openrouter/free
IRAS_BASE_URL=https://openrouter.ai/api/v1
IRAS_REQUEST_TIMEOUT=90
IRAS_MAX_OUTPUT_TOKENS=360

# Cloud providers (configure any subset; multi mode fails over in order).
OPENROUTER_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
GEMINI_API_KEY=
IRAS_PROVIDER_ORDER=groq,cerebras,cloudflare,gemini,openrouter,ollama

# Optional offline/local last-resort model.
IRAS_OLLAMA_FALLBACK=false
IRAS_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
IRAS_OLLAMA_MODEL=qwen2.5-coder:7b
IRAS_OLLAMA_TIMEOUT=45

# ============================================================
# Controller security
# ============================================================
IRAS_AUTO_PERMISSION_LEVEL=1
IRAS_ALWAYS_CONFIRM_CRITICAL=true
IRAS_NODE_TOKEN=generate_a_long_random_node_token
IRAS_NODE_MAX_PERMISSION_LEVEL=1

# Remote/cloud master token: use 32+ random bytes. Never expose it in a client
# bundle or commit it to Git. The web client keeps it in sessionStorage only.
IRAS_API_TOKEN=generate_a_long_random_api_token

# ============================================================
# Voice
# ============================================================
IRAS_TTS_PROVIDER=edge
IRAS_VOICE_PROFILE=anime_soft
IRAS_VOICE=en-US-AriaNeural
IRAS_VOICE_REPLIES=true
IRAS_STT_PROVIDER=whisper_local
IRAS_WHISPER_MODEL=base.en
IRAS_LISTEN_SECONDS=6
# Optional sounddevice index or device name; empty uses Windows default.
IRAS_MIC_DEVICE=

# ============================================================
# Runtime / memory
# ============================================================
IRAS_DATA_DIR=data
IRAS_LOG_DIR=logs
IRAS_MAX_AGENT_STEPS=8
IRAS_SYSTEM_NAME=IRAS
IRAS_ADAPTIVE_PERSONALITY=true

# ============================================================
# Multimodal Windows control — UIA -> OCR ROI -> full vision only if needed
# ============================================================
IRAS_OMNIPARSER_AUTOSTART=true
IRAS_OMNIPARSER_URL=http://127.0.0.1:8010
# IRAS_OMNIPARSER_ROOT=D:\Projects\OmniParser
IRAS_OMNIPARSER_START_TIMEOUT=45
IRAS_OMNIPARSER_TIMEOUT=120
IRAS_OMNIPARSER_CACHE_TTL=180
IRAS_OMNIPARSER_PROBE_TIMEOUT=4
IRAS_OMNIPARSER_DEVICE=cpu
IRAS_OMNIPARSER_BRIDGE=true
IRAS_OMNIPARSER_TEXT_PREWARM=true
IRAS_OMNIPARSER_ROI_MAX_WIDTH=960
IRAS_OMNIPARSER_ROI_MAX_HEIGHT=720
IRAS_VISUAL_ACTION_MIN_CONFIDENCE=0.72
IRAS_WHATSAPP_ROI_FASTPATH=true
IRAS_WHATSAPP_COLD_ROI_RETRIES=2
IRAS_WHATSAPP_COLD_SETTLE_MS=220
# Text-centric WhatsApp control stays OCR/UIA-only by default. Enable this only
# if an unusual icon-only layout truly requires Florence/YOLO as the last resort.
IRAS_WHATSAPP_FULL_VISION_FALLBACK=false

# ============================================================
# Global remote Windows access — cloud server settings
# ============================================================
IRAS_PUBLIC_BASE_URL=
DATABASE_URL=
IRAS_CORS_ORIGINS=*
PORT=8000

# Server-side ceiling for short-lived remote sessions:
# 0=READ, 1=SAFE_ACTION, 2=SYSTEM_ACTION, 3=CRITICAL.
# Full remote administration requires 3, while the laptop's local policy remains
# the final gate and separately controls restart/shutdown and command execution.
IRAS_REMOTE_SESSION_MAX_PERMISSION_LEVEL=3

# Laptop-side remote access is normally managed by `iras --remote-arm ...` and
# persisted under ~/.iras. Environment overrides are available for managed hosts.
IRAS_REMOTE_ACCESS_ENABLED=false
IRAS_REMOTE_ACCESS_MODE=off
IRAS_REMOTE_ACCESS_PERSISTENT=false
IRAS_REMOTE_ALLOW_POWER=false
IRAS_REMOTE_ALLOW_SHELL=false

# File tools remain contained to configured roots. To intentionally expose whole
# Windows drives, configure the bridge with --allowed-root C:\ --allowed-root D:\.
IRAS_BRIDGE_ROOTS=

# v4.1 bounded parallel task execution
IRAS_MULTITASK_WORKERS=4
IRAS_MULTITASK_MAX_TASKS=8
IRAS_MULTITASK_WAIT_TIMEOUT=300


# v4.2 multi-agent task-graph execution
IRAS_ORCHESTRATION_WORKERS=4
IRAS_ORCHESTRATION_MAX_TASKS=12
IRAS_ORCHESTRATION_PROVIDER_WAIT_SECONDS=900
# Planner produces a compact DAG; the final Coordinator node is added automatically.
