# ============================================================
# IRAS BRAIN — OpenRouter is the default cloud provider
# Get your key from your OpenRouter account and keep it private.
# ============================================================
IRAS_PROVIDER=openrouter
OPENROUTER_API_KEY=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
IRAS_MODEL=openrouter/free
IRAS_BASE_URL=https://openrouter.ai/api/v1
IRAS_REQUEST_TIMEOUT=90

# To switch to a specific OpenRouter model, change only IRAS_MODEL.
# Examples depend on what is currently available in your OpenRouter account.

# Security
IRAS_AUTO_PERMISSION_LEVEL=1
IRAS_ALWAYS_CONFIRM_CRITICAL=true
IRAS_API_TOKEN=change-me-before-remote-use
IRAS_NODE_TOKEN=change-me-before-remote-use
IRAS_NODE_MAX_PERMISSION_LEVEL=1

# Voice
IRAS_TTS_PROVIDER=edge
# Anime-inspired profiles: anime_soft, anime_genki, anime_cool, normal
IRAS_VOICE_PROFILE=anime_soft
# Used by the normal profile as an optional voice override.
IRAS_VOICE=en-US-AriaNeural
IRAS_VOICE_REPLIES=true
IRAS_STT_PROVIDER=whisper_local
IRAS_WHISPER_MODEL=base.en
IRAS_LISTEN_SECONDS=6

# Runtime
IRAS_DATA_DIR=data
IRAS_LOG_DIR=logs
IRAS_MAX_AGENT_STEPS=8
IRAS_SYSTEM_NAME=IRAS

# External service secrets (examples; keep real values only in .env)
# IRAS_SECRET_GITHUB=ghp_xxx
# IRAS_SECRET_REMOTE_DESKTOP=long-random-node-token

# Let IRAS gradually learn your preferred conversation style.
IRAS_ADAPTIVE_PERSONALITY=true

# ---- IRAS Cloud v2 ----
# Server-only secrets. Never put OPENROUTER_API_KEY inside Android/Windows clients.
IRAS_API_TOKEN=CHANGE_TO_A_LONG_RANDOM_SECRET
DATABASE_URL=
IRAS_PUBLIC_BASE_URL=
IRAS_CORS_ORIGINS=*
PORT=8000


# ---- IRAS Cloud v2.1 ----
# Render server-side settings
IRAS_PROVIDER=openrouter
IRAS_MODEL=openrouter/free
OPENROUTER_API_KEY=
IRAS_API_TOKEN=
DATABASE_URL=
IRAS_ADAPTIVE_PERSONALITY=true
IRAS_VOICE_PROFILE=anime_soft
IRAS_CORS_ORIGINS=*
